{
  "name": "anime-shelf-pro",
  "version": "1.0.0",
  "description": "追番养肥看板 Pro 桌面版",
  "main": "main.js",
  "scripts": {
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.animeshelf.pro",
    "productName": "追番养肥看板Pro",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    }
  }
}
